# =============================================================================
# Seller-agent LOCAL SANDBOX configuration (mock-only)
# =============================================================================
# This file is committed. It contains NO secrets and must never contain any.
#
# setup.ps1 / setup.sh copy it to sandbox/.local/sandbox.env (git-ignored).
# Edit THAT copy for personal settings such as ANTHROPIC_API_KEY.
#
# sandbox/sandbox_env.py loads this file, then sandbox/.local/sandbox.env on
# top, and refuses to start the server if anything below points at a real
# ad server, SSP, DSP, registry or deal-sync service.
#
# Paths are relative to the repo root (the sandbox scripts always run from
# there). Use forward slashes; they work on Windows too.
# =============================================================================

# --- Seller identity (fictional) ---------------------------------------------
SELLER_ORGANIZATION_ID=sandbox-publisher-001
SELLER_ORGANIZATION_NAME=Sandbox Publisher (fictional)
SELLER_AGENT_URL=http://localhost:8000
SELLER_AGENT_NAME=Sandbox Seller Agent

# --- Inventory: fictional CSV catalog, no ad server --------------------------
# aws_workshop = fictional publisher (Apex Streaming, GNN, Crestline,
# SportsPulse, Horizon Discovery). No real brands, no real company data.
AD_SERVER_TYPE=csv
CSV_DATA_DIR=./data/csv/samples/aws_workshop
GAM_ENABLED=false
FREEWHEEL_ENABLED=false
FREEWHEEL_SH_MCP_URL=
FREEWHEEL_BC_MCP_URL=
FREEWHEEL_API_URL=
S3_DATA_BUCKET=
INVENTORY_SYNC_ENABLED=false

# --- No SSP / deal-sync push -------------------------------------------------
SSP_CONNECTORS=
SSP_ROUTING_RULES=
PUBMATIC_MCP_URL=
MAGNITE_API_URL=
INDEX_EXCHANGE_API_URL=
DEAL_SYNC_CONNECTORS=
DEALS_API_MCP_URL=

# --- OpenDirect: localhost only (nothing listens there by default) -----------
OPENDIRECT_BASE_URL=http://localhost:3000
DEFAULT_PROTOCOL=opendirect21

# --- Agent registry: off, and pointed at a dead local port -------------------
# The legacy registry client is a stub that never calls the URL, but the URL
# is still pinned locally so nothing can reach the live IAB registry.
AGENT_REGISTRY_ENABLED=false
AGENT_REGISTRY_URL=http://127.0.0.1:9/registry-disabled
AGENT_REGISTRY_EXTRA_URLS=
AAMP_REGISTRY_URL=

# --- Storage: local SQLite file under sandbox/.local (git-ignored) -----------
STORAGE_TYPE=sqlite
DATABASE_URL=sqlite:///./sandbox/.local/ad_seller_sandbox.db
AUDIT_FALLBACK_PATH=./sandbox/.local/audit_fallback.jsonl

# --- Pricing -----------------------------------------------------------------
DEFAULT_CURRENCY=USD
MIN_DEAL_VALUE=1000.0
DEFAULT_PRICE_FLOOR_CPM=10.0
YIELD_OPTIMIZATION_ENABLED=true

# --- Human-in-the-loop -------------------------------------------------------
EVENT_BUS_ENABLED=true
# Opt-in gate stays off so ordinary scenarios auto-decide...
APPROVAL_GATE_ENABLED=false
# ...but any proposal worth >= $250,000 gross (CPM x imps / 1000) is ALWAYS
# held for an operator decision. Scenario 5 relies on this threshold.
APPROVAL_REQUIRED_ABOVE_VALUE=250000

# --- Auth --------------------------------------------------------------------
API_KEY_AUTH_ENABLED=true
AUTO_APPROVE_REGISTERED_AGENTS=true
REQUIRE_APPROVAL_FOR_UNREGISTERED=true

# --- LLM (optional) ----------------------------------------------------------
# Leave blank: every scenario in sandbox/scenarios.py is deterministic and
# needs no key. To try the CrewAI paths, put your OWN key in
# sandbox/.local/sandbox.env (never in this file):
#   ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=
DEFAULT_LLM_MODEL=anthropic/claude-sonnet-4-5-20250929
MANAGER_LLM_MODEL=anthropic/claude-sonnet-4-5-20250929
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
CREW_MEMORY_ENABLED=false
CREW_VERBOSE=false
CREWAI_TRACING_ENABLED=false
# POST /proposals answers from the deterministic evaluator unless the budget
# is >= PROPOSAL_CREW_MIN_BUDGET (default 120s). Raise both only if you want
# the LLM review crew to run (slow: minutes per proposal).
PROPOSAL_FLOW_TIME_BUDGET=20
