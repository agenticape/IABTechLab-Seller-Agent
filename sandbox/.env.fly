# =============================================================================
# Seller-agent HOSTED SANDBOX configuration (Fly.io, mock-only, public)
# =============================================================================
# This file is committed and baked into the image. It contains NO secrets and
# must never contain any. Secrets (ANTHROPIC_API_KEY) go in `fly secrets set`.
#
# sandbox/fly_server.py loads this file at boot. Every key listed in
# PINNED_KEYS (sandbox/sandbox_env.py) ALWAYS takes its value from here, even
# when blank, so neither fly.toml [env] nor `fly secrets` can switch a real ad
# server, SSP, deal-sync service or registry back on. Any other key here is a
# default that fly.toml [env] or a Fly secret may override.
#
# Then the same mock-only guard as the local sandbox runs, except that
# SELLER_AGENT_URL must be the public https:// URL instead of localhost.
#
# Relative paths resolve from /app (the repo root inside the image). All state
# lives on the Fly volume mounted at /data.
# =============================================================================

# --- Seller identity (fictional) ---------------------------------------------
SELLER_ORGANIZATION_ID=sandbox-publisher-001
SELLER_ORGANIZATION_NAME=Sandbox Publisher (fictional)
# Advertised in /.well-known/agent.json. fly.toml [env] sets it too; change
# it there if the custom domain changes.
SELLER_AGENT_URL=https://iab-seller.agenticape.ai
SELLER_AGENT_NAME=AgenticApe Sandbox Seller Agent (mock data)

# --- Inventory: fictional CSV catalog, no ad server --------------------------
AD_SERVER_TYPE=csv
CSV_DATA_DIR=./data/csv/samples/aws_workshop
GAM_ENABLED=false
FREEWHEEL_ENABLED=false
FREEWHEEL_SH_MCP_URL=
FREEWHEEL_BC_MCP_URL=
FREEWHEEL_API_URL=
S3_DATA_BUCKET=
INVENTORY_SYNC_ENABLED=false

# --- No SSP / deal-sync push -------------------------------------------------
SSP_CONNECTORS=
SSP_ROUTING_RULES=
PUBMATIC_MCP_URL=
MAGNITE_API_URL=
INDEX_EXCHANGE_API_URL=
DEAL_SYNC_CONNECTORS=
DEALS_API_MCP_URL=

# --- OpenDirect: localhost only (nothing listens there) ----------------------
OPENDIRECT_BASE_URL=http://localhost:3000
DEFAULT_PROTOCOL=opendirect21

# --- Agent registry: off, and pointed at a dead local port -------------------
AGENT_REGISTRY_ENABLED=false
AGENT_REGISTRY_URL=http://127.0.0.1:9/registry-disabled
AGENT_REGISTRY_EXTRA_URLS=
AAMP_REGISTRY_URL=

# --- Storage: SQLite on the Fly volume ---------------------------------------
STORAGE_TYPE=sqlite
DATABASE_URL=sqlite:////data/ad_seller_sandbox.db
REDIS_URL=
AUDIT_FALLBACK_PATH=/data/audit_fallback.jsonl

# --- Pricing -----------------------------------------------------------------
DEFAULT_CURRENCY=USD
MIN_DEAL_VALUE=1000.0
DEFAULT_PRICE_FLOOR_CPM=10.0
YIELD_OPTIMIZATION_ENABLED=true

# --- Human-in-the-loop -------------------------------------------------------
EVENT_BUS_ENABLED=true
APPROVAL_GATE_ENABLED=false
# Scenario 5 in sandbox/scenarios.py relies on this threshold.
APPROVAL_REQUIRED_ABOVE_VALUE=250000

# --- Auth --------------------------------------------------------------------
API_KEY_AUTH_ENABLED=true
AUTO_APPROVE_REGISTERED_AGENTS=true
REQUIRE_APPROVAL_FOR_UNREGISTERED=true

# --- LLM (optional) ----------------------------------------------------------
# Leave blank here. To enable the CrewAI paths:
#   fly secrets set ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=
DEFAULT_LLM_MODEL=anthropic/claude-sonnet-4-5-20250929
MANAGER_LLM_MODEL=anthropic/claude-sonnet-4-5-20250929
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
CREW_MEMORY_ENABLED=false
CREW_VERBOSE=false
CREWAI_TRACING_ENABLED=false
# Deterministic proposal evaluation (no LLM spend from anonymous traffic).
# Raise both via fly.toml [env] to let POST /proposals run the review crew.
PROPOSAL_FLOW_TIME_BUDGET=20
