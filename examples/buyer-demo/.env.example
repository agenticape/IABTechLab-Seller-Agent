# Copy to a local shell or `export` these. Do not put real values in this file.
# See RUN.md for where the keys come from.

SELLER_URL=https://iab-seller.agenticape.ai

# Preferred: path to the minted sandbox keys JSON (operator + buyer tiers).
# On the deploy clone this is typically:
#   sandbox/.local/keys.fly.json
# KEYS_FILE=

# Or export individual buyer keys (advertiser is enough for most scenarios;
# agency is needed to show an in-band negotiation vs a below-floor lowball).
# SELLER_API_KEY=
# SELLER_API_KEY_AGENCY=
# SELLER_API_KEY_SEAT=
